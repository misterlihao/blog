---
import { LOCALES, LOCALE_META, type Locale } from '~/config';
import BaseLayout from '~/layouts/BaseLayout.astro';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const meta = LOCALE_META[locale];
// Pagefind assets are emitted into <base>/pagefind/ at build time.
const bundlePath = import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/';
---
<BaseLayout locale={locale} title={meta.ui.search} noindex={true}>
  <section class="container">
    <h1 class="page-title">{meta.ui.search}</h1>
    <div id="search"></div>
    <p class="hint">Pagefind ⋅ 搜尋僅在正式建置後可用 (npm run build && npm run preview)</p>
  </section>
</BaseLayout>

<link rel="stylesheet" href={bundlePath + 'pagefind-ui.css'} />
<script is:inline define:vars={{ bundlePath, placeholder: meta.ui.searchPlaceholder }}>
  function boot() {
    // eslint-disable-next-line no-undef
    new PagefindUI({
      element: '#search',
      bundlePath,
      showSubResults: true,
      showImages: false,
      translations: { placeholder },
    });
  }
  const s = document.createElement('script');
  s.src = bundlePath + 'pagefind-ui.js';
  s.onload = boot;
  s.onerror = () => {
    document.getElementById('search').innerHTML =
      '<p style="color:var(--fg-muted)">index not built yet</p>';
  };
  document.head.appendChild(s);
</script>

<style>
  .page-title { font-size: 1.6rem; margin: 2.5rem 0 1rem; }
  .hint { color: var(--fg-muted); font-size: 0.8rem; margin-top: 1rem; }
  :global(.pagefind-ui) {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-font: var(--font-body);
  }
</style>
