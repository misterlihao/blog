---
/**
 * Labeled 1-D spectrum. Turns an ordered "A → B → C" progression
 * (predictability, effort ladder, soft→hard) into a visual axis.
 */
interface Props {
  from?: string;
  to?: string;
  items: string[];
}
const { from, to, items } = Astro.props;
---
<div class="scale">
  {(from || to) && (
    <div class="ends">
      <span>{from}</span>
      <span class="arrow" aria-hidden="true">→</span>
      <span>{to}</span>
    </div>
  )}
  <ol class="track" style={`--n:${items.length}`}>
    {items.map((it) => (
      <li><span class="dot" aria-hidden="true"></span><span class="label">{it}</span></li>
    ))}
  </ol>
</div>

<style>
  .scale { margin: 1.8rem 0; }
  .ends { display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; color: var(--fg-muted); margin-bottom: 0.5rem; }
  .ends .arrow { flex: 1; text-align: center; opacity: 0.5; }
  .track {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(var(--n), 1fr);
    position: relative;
  }
  .track::before {
    content: ""; position: absolute; top: 0.5rem; left: 6%; right: 6%;
    height: 2px; background: var(--border);
  }
  .track li { display: flex; flex-direction: column; align-items: center; gap: 0.45rem; text-align: center; position: relative; }
  .dot { width: 1rem; height: 1rem; border-radius: 50%; background: var(--accent); border: 3px solid var(--bg); position: relative; z-index: 1; }
  .label { font-size: 0.9rem; font-weight: 600; line-height: 1.35; }
  @media (max-width: 30rem) { .label { font-size: 0.8rem; } }
</style>
