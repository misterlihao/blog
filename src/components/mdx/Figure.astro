---
interface Props {
  src: string;
  alt?: string;
  caption?: string;
  width?: number;
}
const { src, alt = '', caption, width } = Astro.props;
---
<figure class="figure">
  <img src={src} alt={alt} width={width} loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure { margin: 1.6rem 0; }
  .figure img { display: block; width: 100%; border-radius: var(--radius); }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
    text-align: center;
  }
</style>
