---
// Usage: <Gallery images={[{src,alt},...]} columns={3} />
interface Img { src: string; alt?: string; }
interface Props { images: Img[]; columns?: number; }
const { images, columns = 3 } = Astro.props;
---
<div class="gallery" style={`--cols:${columns}`}>
  {images.map((im) => (
    <img src={im.src} alt={im.alt ?? ''} loading="lazy" decoding="async" />
  ))}
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 0.6rem;
    margin: 1.6rem 0;
  }
  .gallery img { width: 100%; height: 100%; object-fit: cover; border-radius: 8px; aspect-ratio: 4 / 3; }
  @media (max-width: 34rem) { .gallery { grid-template-columns: repeat(2, 1fr); } }
</style>
